#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required. Install it, then run: uv sync --locked --group dev" >&2
  exit 127
fi

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

# Keep offline replay independent from local secrets. The CLI defaults to offline;
# only an explicit online mode is allowed to import the ignored .env file.
MODE="offline"
ARGS=("$@")
for ((index = 0; index < ${#ARGS[@]}; index++)); do
  case "${ARGS[$index]}" in
    --mode=*) MODE="${ARGS[$index]#--mode=}" ;;
    --mode)
      if (( index + 1 < ${#ARGS[@]} )); then
        MODE="${ARGS[$((index + 1))]}"
      fi
      ;;
  esac
done

if [[ "$MODE" == "online" && -f "$ROOT/.env" ]]; then
  exec uv run --locked --env-file .env python -m fundo_reviewer.cli "$@"
fi
exec uv run --locked python -m fundo_reviewer.cli "$@"
